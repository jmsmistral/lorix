{
  "name": "lorix",
  "version": "0.3.0",
  "description": "A small, composable JavaScript DataFrame API for in-memory data wrangling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmsmistral/lorix"
  },
  "homepage": "https://github.com/jmsmistral/lorix",
  "main": "lorix.js",
  "type": "module",
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-dsv": "^3.0.1",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.1",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "test": "mocha \"test/test_*.js\"",
    "test:coverage": "c8 --check-coverage --lines 90 --statements 90 --functions 90 --branches 85 npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run test:package",
    "test:package": "node scripts/check-package.js",
    "example": "node example.js"
  },
  "keywords": [
    "dataframe",
    "dataset",
    "data",
    "analysis",
    "datascience"
  ],
  "author": "Jonathan Sacramento",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "files": [
    "lorix.js",
    "src/",
    "docs/images/lorix.png"
  ],
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js",
      "lorix.js"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
